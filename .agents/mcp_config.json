{
  "mcpServers": {
    "playwright": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "semgrep": {
      "command": "semgrep",
      "args": [
        "mcp",
        "-t",
        "stdio"
      ]
    }
  }
}
